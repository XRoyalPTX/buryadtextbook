msgid "Главная страница"
msgstr "Home page"

#: .\home\templates\home\homepage.html:21
msgid "Интерактивное изучение"
msgstr "Interactive learning of"

#: .\home\templates\home\homepage.html:21
msgid "бурятского языка"
msgstr "the Buryad language"

#: .\home\templates\home\homepage.html:24
