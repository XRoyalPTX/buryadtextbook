# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Секретный ключ Django (обязательно сгенерируйте уникальный для продакшена)
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=127.0.0.1,localhost,.sesen.su

# База данных PostgreSQL
DB_NAME=buryadtextbook
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Настройки почты (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=your_email@yandex.ru

# Настройки безопасности HTTPS (актуально для продакшена)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
